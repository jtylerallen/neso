---
// Inline SVG icons (24x24, 1.75 stroke, currentColor) — colored via CSS to brand green.
const icons = {
	target: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/><path d="M12 1v3M12 20v3M1 12h3M20 12h3"/>`,
	chart: `<path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6" rx="0.5"/><rect x="12" y="8" width="3" height="10" rx="0.5"/><rect x="17" y="4" width="3" height="14" rx="0.5"/>`,
	tag: `<path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L3 13V3h10l7.59 7.59a2 2 0 0 1 0 2.82z"/><circle cx="7.5" cy="7.5" r="1.5"/>`,
	rocket: `<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>`,
	route: `<circle cx="6" cy="19" r="2.5"/><circle cx="18" cy="5" r="2.5"/><path d="M8.5 19H15a3.5 3.5 0 0 0 0-7H9a3.5 3.5 0 0 1 0-7h6.5"/>`,
	userHeart: `<circle cx="10" cy="8" r="4"/><path d="M3 21v-1a6 6 0 0 1 8.4-5.5"/><path d="M18.5 21.5 22 18a1.9 1.9 0 0 0-2.7-2.7l-.3.3-.3-.3a1.9 1.9 0 0 0-2.7 2.7z"/>`,
	puzzle: `<path d="M19.439 7.85c-.049.322.059.648.289.878l1.568 1.568c.47.47.706 1.087.706 1.704s-.235 1.233-.706 1.704l-1.611 1.611a.98.98 0 0 1-.837.276c-.47-.07-.802-.48-.968-.925a2.501 2.501 0 1 0-3.214 3.214c.446.166.855.497.925.968a.979.979 0 0 1-.276.837l-1.61 1.61a2.404 2.404 0 0 1-1.705.707 2.402 2.402 0 0 1-1.704-.706l-1.568-1.568a1.026 1.026 0 0 0-.877-.29c-.493.074-.84.504-1.02.968a2.5 2.5 0 1 1-3.237-3.237c.464-.18.894-.527.967-1.02a1.026 1.026 0 0 0-.289-.877l-1.568-1.568A2.402 2.402 0 0 1 1.998 12c0-.617.236-1.234.706-1.704L4.23 8.77c.24-.24.581-.353.917-.303.515.077.877.528 1.073 1.01a2.5 2.5 0 1 0 3.259-3.259c-.482-.196-.933-.558-1.01-1.073-.05-.336.062-.676.303-.917l1.525-1.525A2.402 2.402 0 0 1 12 1.998c.617 0 1.234.236 1.704.706l1.568 1.568c.23.23.556.338.877.29.493-.074.84-.504 1.02-.968a2.5 2.5 0 1 1 3.237 3.237c-.464.18-.894.527-.967 1.02Z"/>`,
	gear: `<circle cx="12" cy="12" r="3.5"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>`,
};

const services = [
	{
		title: "Product Strategy",
		icon: icons.target,
		body: "We help you craft a winning product strategy built for the realities of modern SaaS. Working closely with your team, we define your target market, surface growth opportunities, and shape a roadmap that maps directly to your business objectives — with AI-driven analysis sharpening every assumption along the way.",
	},
	{
		title: "Market Analysis & Research",
		icon: icons.chart,
		body: "Great products start with a deep understanding of your customers, competitors, and market. We pair quantitative surveys and qualitative interviews with AI-assisted synthesis to turn raw signal into clear direction, guiding product offerings, feature priorities, and where to innovate next.",
	},
	{
		title: "Pricing Strategy",
		icon: icons.tag,
		body: "The right pricing and packaging can transform your business. Our tailored approach aligns pricing with your goals, drives consistent year-over-year revenue growth, and keeps customers delighted. We use AI to model scenarios and pressure-test packaging before you commit.",
	},
	{
		title: "Go-to-Market",
		icon: icons.rocket,
		body: "We help you launch with impact and sustain momentum. From GTM strategy to customer feedback loops, we guide you across the full product lifecycle — optimizing performance, engagement, and satisfaction. AI-powered tooling helps us move faster and read the market in real time.",
	},
	{
		title: "Roadmap Development",
		icon: icons.route,
		body: "We build comprehensive roadmaps that make milestones, priorities, and resourcing clear to everyone. Our process streamlines product development so you ship high-quality work efficiently, with AI-informed forecasting keeping timelines and trade-offs honest.",
	},
	{
		title: "User Centric Design",
		icon: icons.userHeart,
		body: "We put your customers at the center of everything. Through user research and thoughtful UX/UI design, we ensure your product delivers an experience that keeps people engaged and coming back — accelerated by AI tools that help us prototype, test, and iterate on ideas quickly.",
	},
	{
		title: "Product Market Fit",
		icon: icons.puzzle,
		body: "Product-market fit is a journey, not a milestone. Our iterative process runs from customer discovery through validation and roadmap development, keeping Sales, Marketing, and Customer Success aligned. AI-assisted analysis helps us spot the signals of fit — and its absence — sooner.",
	},
	{
		title: "Product & DevOps",
		icon: icons.gear,
		body: "We help you embrace agile methods and streamline delivery end to end. From implementing the right frameworks to enabling rapid iteration and continuous improvement, we help your team ship delightful products faster — with AI woven into the workflow to remove friction.",
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Neso Advisors is a full-stack, AI-enabled product management advisory firm — strategy, research, GTM, and design to help software teams ship better products."
		/>
		<link rel="canonical" href="https://nesoadvisors.com/" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://nesoadvisors.com/" />
		<meta
			property="og:title"
			content="Neso Advisors — AI-Enabled Product Management"
		/>
		<meta
			property="og:description"
			content="AI-driven product strategy, design, and go-to-market expertise to help software teams make better decisions, accelerate delivery, and drive measurable growth."
		/>
		<meta
			property="og:image"
			content="https://nesoadvisors.com/apple-touch-icon.png"
		/>

		<!-- Twitter -->
		<meta name="twitter:card" content="summary" />
		<meta
			name="twitter:title"
			content="Neso Advisors — AI-Enabled Product Management"
		/>
		<meta
			name="twitter:description"
			content="AI-driven product strategy, design, and go-to-market expertise to help software teams make better decisions, accelerate delivery, and drive measurable growth."
		/>
		<meta
			name="twitter:image"
			content="https://nesoadvisors.com/apple-touch-icon.png"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@300;400;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Neso Advisors — AI-Enabled Product Management</title>
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a href="#top" class="brand" aria-label="Neso Advisors — home">
					<img
						src="/images/logo-no-tagline.svg"
						alt="Neso Advisors"
						width="190"
						height="114"
					/>
				</a>
				<nav class="nav" aria-label="Primary">
					<a href="#services">Services</a>
					<a href="#contact">Contact</a>
				</nav>
			</div>
		</header>

		<main id="top">
			<section class="hero">
				<div class="container">
					<p class="eyebrow">AI-Enabled Product Management</p>
					<h1>
						Your full-stack product management partner -
						supercharged by AI.
					</h1>
					<p class="hero-sub">
						Neso Advisors applies AI-driven product strategy, design,
						and go-to-market expertise to help software teams make
						better decisions, accelerate delivery, and drive
						measurable growth.
					</p>
					<a href="#contact" class="btn">Start a conversation</a>
				</div>
			</section>

			<section class="intro">
				<div class="container">
					<p>
						We partner with teams across every stage of the product
						lifecycle — from first insight to scaled growth —
						empowering software organizations and supercharging
						product success. Our approach blends seasoned product
						judgment with modern, AI-informed tooling, so decisions
						are grounded in evidence rather than guesswork.
					</p>
					<p>
						We understand the competitive challenges you're facing.
						We fine-tune roadmaps, optimize strategy, and maximize
						revenue by combining deep market knowledge with AI that
						helps us analyze faster, model more scenarios, and see
						patterns others miss. This isn't AI as a pivot — it's
						simply how Neso operates today.
					</p>
					<p>
						The result is a practice that moves at the speed your
						market demands, with the rigor your product deserves.
						Whether you need a fractional product leader or a focused
						engagement, we meet you where you are and help you get
						where you're going.
					</p>
				</div>
			</section>

			<section id="services" class="services">
				<div class="container">
					<h2>Services</h2>
					<p class="section-lead">
						Practical, senior product leadership across the full
						lifecycle — each engagement amplified by AI.
					</p>
					<div class="services-grid">
						{
							services.map((service) => (
								<article class="card">
									<span class="card-icon" aria-hidden="true">
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
											set:html={service.icon}
										/>
									</span>
									<h3>{service.title}</h3>
									<p>{service.body}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section id="contact" class="contact">
				<div class="container">
					<h2>Let's build something great</h2>
					<p>
						Tell us about your product and where you want to take it.
						We'll show you how an AI-enabled product practice can help
						you get there.
					</p>
					<form class="contact-form" method="post" action="#">
						<div class="field">
							<label for="name">Name</label>
							<input
								type="text"
								id="name"
								name="name"
								autocomplete="name"
								required
							/>
						</div>
						<div class="field">
							<label for="email">Email</label>
							<input
								type="email"
								id="email"
								name="email"
								autocomplete="email"
								required
							/>
						</div>
						<div class="field">
							<label for="message">Message</label>
							<textarea
								id="message"
								name="message"
								rows="5"
								required></textarea>
						</div>
						<button type="submit" class="btn">Send message</button>
					</form>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="container">
				<p>&copy; 2022&ndash;2026 Neso Advisors, LLC</p>
			</div>
		</footer>
	</body>
</html>

<style>
	:root {
		--primary: #3e640e;
		--secondary: #9fa397;
		--accent: #5d9943;
		--bg: #ffffff;
		--ink: #232821;
		--muted: #5f665a;
		--line: #e6e8e2;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		font-family: "Source Sans Pro", system-ui, -apple-system, sans-serif;
		font-weight: 300;
		color: var(--ink);
		background: var(--bg);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	.container {
		width: 100%;
		max-width: 1120px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	h1,
	h2,
	h3 {
		font-weight: 600;
		line-height: 1.2;
		color: var(--primary);
		margin: 0;
	}

	a {
		color: var(--accent);
		text-decoration: none;
	}

	/* Header */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 84px;
		padding: 0.5rem 1.5rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
	}

	.brand img {
		width: 190px;
		height: auto;
		display: block;
	}

	.nav {
		display: flex;
		gap: 2rem;
	}

	.nav a {
		color: var(--ink);
		font-weight: 400;
		font-size: 1rem;
		transition: color 0.15s ease;
	}

	.nav a:hover {
		color: var(--accent);
	}

	/* Hero */
	.hero {
		position: relative;
		padding: 6.5rem 0 5.5rem;
		background-image: linear-gradient(
				rgba(20, 32, 6, 0.6),
				rgba(20, 32, 6, 0.6)
			),
			url("/images/hero-bg.png");
		background-size: auto 140%;
		background-position: right top;
		background-repeat: no-repeat;
		border-bottom: 1px solid var(--line);
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.8rem;
		font-weight: 600;
		color: #fff;
		margin: 0 0 1rem;
	}

	.hero h1 {
		font-size: clamp(2.1rem, 5vw, 3.4rem);
		max-width: 18ch;
		color: #fff;
	}

	.hero-sub {
		font-size: clamp(1.05rem, 2.2vw, 1.3rem);
		color: rgba(255, 255, 255, 0.9);
		max-width: 60ch;
		margin: 1.5rem 0 2.25rem;
	}

	.btn {
		display: inline-block;
		background: var(--primary);
		color: #fff;
		font-weight: 600;
		padding: 0.85rem 1.75rem;
		border-radius: 6px;
		transition:
			background 0.15s ease,
			transform 0.15s ease;
	}

	.btn:hover {
		background: var(--accent);
		transform: translateY(-1px);
	}

	/* Intro */
	.intro {
		padding: 4.5rem 0;
	}

	.intro .container {
		max-width: 820px;
	}

	.intro p {
		font-size: 1.15rem;
		color: var(--ink);
		margin: 0 0 1.5rem;
	}

	.intro p:last-child {
		margin-bottom: 0;
	}

	/* Services */
	.services {
		padding: 4.5rem 0;
		background: #f8f9f5;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.services h2 {
		font-size: clamp(1.8rem, 4vw, 2.5rem);
	}

	.section-lead {
		color: var(--muted);
		font-size: 1.15rem;
		margin: 0.75rem 0 2.5rem;
		max-width: 55ch;
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}

	/* Tablet: 2 columns (2x4) */
	@media (max-width: 1000px) {
		.services-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* Mobile: 1 column (1x8) */
	@media (max-width: 600px) {
		.services-grid {
			grid-template-columns: 1fr;
		}
	}

	.card {
		background: #fff;
		border: 1px solid var(--line);
		border-radius: 10px;
		padding: 1.75rem;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.15s ease;
	}

	.card:hover {
		border-color: var(--accent);
		box-shadow: 0 12px 28px rgba(62, 100, 14, 0.08);
		transform: translateY(-2px);
	}

	.card-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: 10px;
		background: rgba(62, 100, 14, 0.08);
		color: var(--primary);
		margin-bottom: 1.1rem;
	}

	.card-icon svg {
		width: 26px;
		height: 26px;
	}

	.card h3 {
		font-size: 1.25rem;
		margin-bottom: 0.6rem;
	}

	.card p {
		margin: 0;
		color: var(--muted);
		font-size: 1rem;
	}

	/* Contact */
	.contact {
		padding: 5rem 0;
		text-align: center;
	}

	.contact h2 {
		font-size: clamp(1.8rem, 4vw, 2.5rem);
	}

	.contact p {
		color: var(--muted);
		font-size: 1.2rem;
		max-width: 52ch;
		margin: 1rem auto 2.5rem;
	}

	.contact-form {
		max-width: 560px;
		margin: 0 auto;
		text-align: left;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.field label {
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--ink);
	}

	.field input,
	.field textarea {
		font-family: inherit;
		font-size: 1rem;
		font-weight: 300;
		color: var(--ink);
		background: #fff;
		border: 1px solid var(--line);
		border-radius: 6px;
		padding: 0.75rem 0.9rem;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease;
	}

	.field textarea {
		resize: vertical;
		min-height: 120px;
	}

	.field input:focus,
	.field textarea:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 3px rgba(93, 153, 67, 0.15);
	}

	.contact-form .btn {
		align-self: flex-start;
		border: none;
		cursor: pointer;
		font-family: inherit;
		font-size: 1rem;
		margin-top: 0.25rem;
	}

	/* Footer */
	.site-footer {
		border-top: 1px solid var(--line);
		padding: 2rem 0;
		background: #fff;
	}

	.site-footer p {
		margin: 0;
		color: var(--secondary);
		font-size: 0.95rem;
	}

	@media (max-width: 560px) {
		.header-inner {
			min-height: 0;
			padding: 0.85rem 1.5rem;
			gap: 0.75rem;
		}

		.brand img {
			width: 150px;
		}

		.nav {
			gap: 1rem;
		}

		.nav a {
			font-size: 0.95rem;
		}

		.hero {
			padding: 3.5rem 0 3rem;
		}
	}

	@media (max-width: 380px) {
		.header-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
